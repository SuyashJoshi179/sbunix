{
    "name": "SBUnix - RISC-V OS Development",
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:1": {
            "installZsh": true,
            "configureZshAsDefaultShell": true
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack",
                "dan-c-underwood.riscv-asm"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                "C_Cpp.default.compilerPath": "/usr/bin/riscv64-unknown-elf-gcc",
                "C_Cpp.default.compilerArgs": [
                    "-march=rv64imac_zicsr_zifencei",
                    "-mabi=lp64",
                    "-mcmodel=medany"
                ]
            }
        }
    },
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt",
        "seccomp=unconfined",
        "--privileged"
    ],
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y gcc-riscv64-unknown-elf binutils-riscv64-unknown-elf gdb-multiarch qemu-system-misc build-essential make"
}